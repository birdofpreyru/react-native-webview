{
  "name": "react-native-webview-monorepo",
  "private": true,
  "workspaces": [
    "packages/react-native-webview",
    "packages/example-shared",
    "packages/example-mobile"
  ],
  "scripts": {
    "android": "yarn packages/example-mobile android",
    "build": "yarn packages/react-native-webview build",
    "ios": "yarn --cwd packages/example-mobile ios",
    "lint": "yarn lint:tsc && yarn eslint . --ext .ts,.tsx,.js,.jsx",
    "lint:tsc": "tsc --noEmit && tsc --noEmit --project tsconfig.example.json",
    "macos": "yarn packages/example-macos macos",
    "prepare:types": "yarn packages/react-native-webview prepare:types",
    "prepare": "yarn packages/react-native-webview prepare",
    "start": "yarn packages/example-mobile start",
    "test": "yarn lint",
    "visionos": "yarn packages/example-visionos visionos",
    "windows": "yarn packages/example-windows windows"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/runtime": "^7.29.10",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@react-native/metro-config": "0.88.1",
    "@react-native/typescript-config": "0.88.1",
    "@rnx-kit/metro-config": "2.2.6",
    "@types/jest": "^30.0.0",
    "@types/react": "19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-ft-flow": "^3.0.11",
    "jest": "^30.5.2",
    "react": "19.3.1",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": "^22.13.0 || ^24.3.0 || >=26.0.0"
  },
  "packageManager": "yarn@4.18.1"
}
