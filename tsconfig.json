{
  "extends": "@react-native/typescript-config",
  "include": ["packages/react-native-webview/src/*"],
  "compilerOptions": {
    "customConditions": ["react-native", "react-native-legacy-deep-imports"],
    "rootDir": ".",
    "paths": {
      "@dr.pogodin/react-native-webview": ["./packages/react-native-webview/src/index"],
      "@dr.pogodin/react-native-webview/*": ["./packages/react-native-webview/src/*"]
    },

    // TODO: We should get rid of it, but then we need to reconfigure
    // the types build config (yarn prepare:types) to no catch misc config
    // JS files in the root of the codebase (thus outside the root dir configured
    // for TS).
    "allowJs": false,

    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true
  }
}
